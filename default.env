# ── Xuekao MCQ grader — default config (safe to commit) ──────────────────────
# Non-secret defaults. Secrets (DASHSCOPE_API_KEY) + local overrides go in .env
# (gitignored), which loads AFTER this file and overrides these values.
#
# Model spec:  <model>, <thinking_tokens>[, <max_output_tokens>]
#   thinking_tokens: 0 = off (non-streaming json mode, deterministic). >0 = reasoning (streamed).
#   Provider inferred from the model name (qwen* → DashScope).

# ── Models (all Qwen via DashScope) ──────────────────────────────────────────
# Name→roster match + class: reasoning ON, small answer.
IDENTITY_MODEL=qwen3.7-plus, 2048, 512
# MCQ bubble read: reasoning ON — bubble-by-bubble deliberation fixes misreads
# (faint fills, cross-outs, single-vs-double). Streamed; JSON recovered from text.
ANSWERS_MODEL=qwen3.7-plus, 2048, 3000
# Official-key read (once): reasoning ON, larger answer.
KEY_MODEL=qwen3.7-plus, 1024, 2048

# Determinism (injected per call; explicit per-call values win).
ALL_AI_TEMPERATURE=0
ALL_AI_SEED=42

# ── Rendering ────────────────────────────────────────────────────────────────
DPI=300
ORIENT_DPI=150               # low-dpi pass for orientation / mark probe
IDENTITY_LONG_EDGE=2200      # identity crop downscale (name + class)
MCQ_LONG_EDGE=3000           # MCQ crop downscale — high res to keep bubble detail
KEY_LONG_EDGE=3000           # answer-key page downscale
JPEG_QUALITY=92

# ── Behaviour ────────────────────────────────────────────────────────────────
MAX_WORKERS=64               # parallel AI calls (Stage B)
GEOM_WORKERS=6               # parallel geometry pages (Stage A; memory-bounded)
LOW_CONFIDENCE=2             # forms at/below this confidence → Review sheet
